# LinkEarn Environment Variables Example

# Database Connection (PostgreSQL or SQLite)
# For PostgreSQL: postgresql://username:password@localhost:5432/linkearn?schema=public
# For SQLite (local zero-config): file:./dev.db
DATABASE_URL="file:./dev.db"

# Authentication secret for signed sessions and tokens
AUTH_SECRET="your-super-secret-random-key-at-least-32-characters"

# Base URL for public redirects and canonical links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Admin Credentials for seed script
ADMIN_DEFAULT_EMAIL="admin@linkearn.com"
ADMIN_DEFAULT_PASSWORD="AdminSecure123!"

# Platform Configuration Defaults
MIN_WITHDRAWAL_AMOUNT="10.00"
REFERRAL_PERCENT_COMMISSION="5.0"
PLATFORM_DEFAULT_CURRENCY="USD"
